{
  "permissions": {
    "allow": [
      "Bash(pnpm test*)",
      "Bash(pnpm lint*)",
      "Bash(pnpm typecheck*)",
      "Bash(pnpm build*)",
      "Bash(pnpm check*)",
      "Bash(git status*)",
      "Bash(ls*)",
      "Bash(pnpm -s test*)",
      "Bash(pnpm -s lint*)",
      "Bash(pnpm -s typecheck*)",
      "Bash(pnpm -s build*)",
      "Bash(pnpm -s check*)",
      "Bash(node --import tsx --test tests/*)"
    ],
    "deny": [
      "Read(//**/.env*)",
      "Read(**/.env*)",
      "Edit(**/docs/preregistration.md)",
      "Write(**/docs/preregistration.md)",
      "Edit(**/tasks/backlog*.md)",
      "Write(**/tasks/backlog*.md)",
      "Bash(git push*)",
      "Bash(git commit*)",
      "Bash(git reset*)",
      "Bash(curl*)",
      "Bash(wget*)",
      "Bash(pnpm add*)",
      "Bash(pnpm install*)",
      "Bash(vercel*)",
      "WebFetch",
      "WebSearch",
      "Agent",
      "Edit(**/.claude/**)",
      "Write(**/.claude/**)",
      "Edit(**/.githooks/**)",
      "Write(**/.githooks/**)",
      "Edit(**/scripts/check.sh)",
      "Write(**/scripts/check.sh)",
      "Edit(**/scripts/night.sh)",
      "Write(**/scripts/night.sh)",
      "Edit(**/scripts/night-lib.sh)",
      "Write(**/scripts/night-lib.sh)",
      "Edit(**/scripts/night-probe.sh)",
      "Write(**/scripts/night-probe.sh)",
      "Edit(**/lib/karte/verify.ts)",
      "Write(**/lib/karte/verify.ts)",
      "Edit(**/lib/eval/**)",
      "Write(**/lib/eval/**)",
      "Edit(**/package.json)",
      "Write(**/package.json)",
      "Edit(**/.gitignore)",
      "Write(**/.gitignore)",
      "Edit(**/node_modules/**)",
      "Write(**/node_modules/**)",
      "Edit(**/eslint.config.*)",
      "Write(**/eslint.config.*)",
      "Edit(**/tsconfig.json)",
      "Write(**/tsconfig.json)",
      "Edit(**/next.config.*)",
      "Write(**/next.config.*)",
      "Edit(**/pnpm-workspace.yaml)",
      "Write(**/pnpm-workspace.yaml)",
      "Edit(**/.npmrc)",
      "Write(**/.npmrc)",
      "Edit(**/pnpm-lock.yaml)",
      "Write(**/pnpm-lock.yaml)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/deny-dangerous-bash.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": false,
    "filesystem": {
      "denyRead": []
    },
    "network": {
      "allowedDomains": [],
      "allowLocalBinding": true
    },
    "credentials": {
      "envVars": [
        {
          "name": "ANTHROPIC_API_KEY",
          "mode": "deny"
        }
      ]
    }
  }
}
