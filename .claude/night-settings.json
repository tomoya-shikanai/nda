{
  "permissions": {
    "allow": [
      "Bash(pnpm test*)",
      "Bash(pnpm lint*)",
      "Bash(pnpm typecheck*)",
      "Bash(pnpm build*)",
      "Bash(pnpm check*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(ls*)"
    ],
    "deny": [
      "Read(//**/data/recordings/**)",
      "Read(//**/data/audio/**)",
      "Read(//**/data/transcripts/**)",
      "Read(//**/data/kartes/**)",
      "Read(//**/.env*)",
      "Read(**/.env*)",
      "Read(**/data/recordings/**)",
      "Read(**/data/audio/**)",
      "Read(**/data/transcripts/**)",
      "Read(**/data/kartes/**)",
      "Edit(**/docs/preregistration.md)",
      "Write(**/docs/preregistration.md)",
      "Edit(**/tasks/backlog*.md)",
      "Write(**/tasks/backlog*.md)",
      "Bash(git push*)",
      "Bash(git commit*)",
      "Bash(git reset*)",
      "Bash(curl*)",
      "Bash(wget*)",
      "Bash(pnpm add*)",
      "Bash(pnpm install*)",
      "Bash(vercel*)",
      "WebFetch",
      "WebSearch",
      "Agent",
      "Edit(**/.claude/**)",
      "Write(**/.claude/**)",
      "Edit(**/.githooks/**)",
      "Write(**/.githooks/**)",
      "Edit(**/scripts/check.sh)",
      "Write(**/scripts/check.sh)",
      "Edit(**/scripts/night.sh)",
      "Write(**/scripts/night.sh)",
      "Edit(**/lib/karte/verify.ts)",
      "Write(**/lib/karte/verify.ts)",
      "Edit(**/package.json)",
      "Write(**/package.json)",
      "Edit(**/.gitignore)",
      "Write(**/.gitignore)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/deny-dangerous-bash.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
