# Claude の API キー。https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# ElevenLabs（Scribe v2）の API キー。https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Gemini の API キー。https://aistudio.google.com/apikey
GEMINI_API_KEY=
# AmiVoice の APPKEY。https://acp.amivoice.com/
AMIVOICE_APP_KEY=
# 事務所の受け箱（工場→事務所）。事務所の PC の共有フォルダ（SMB）を mount した先の受け箱（Mac では偽の事務所のフォルダ）。受け箱には事務所側が目印 .nda-box を置く。空なら事務所なし（客の照合もしない）。NDA_OFFICE_SFTP は口だけ（未実装）
NDA_OFFICE_BOX=
NDA_OFFICE_SFTP=
# 受け箱が mount した先（/ と別の dev）であることを確かめる。既定は確かめる。Mac の偽の事務所では 0
NDA_OFFICE_BOX_REQUIRE_MOUNT=
# 事務所→工場の返し（POST /api/office/reply）の合言葉。空なら受け口は閉じる（503）。事務所の box\config.json の secret と同じ値
NDA_OFFICE_TOKEN=
# 出来事の記録（JSONL）の置き場。空なら記録しない。工場の Pi は /var/lib/nda/logs。記録するものと守りは docs/logging.md
NDA_LOG_DIR=
