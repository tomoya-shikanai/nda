{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "sessionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "sentAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "kind": {
      "type": "string",
      "const": "invoice.result"
    },
    "requestId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "entered",
        "stopped",
        "deferred",
        "withdrawn",
        "saved"
      ]
    },
    "enteredLines": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "reason": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "busy",
            "appNotRunning",
            "unknownItem",
            "customerNotAllowed",
            "customerNotFound",
            "duplicate",
            "invalid",
            "readbackMismatch",
            "other"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "readback": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "item": {
                "type": "string"
              },
              "qty": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "unitPrice": {
                "type": [
                  "number",
                  "null"
                ]
              }
            },
            "required": [
              "item",
              "qty",
              "unitPrice"
            ]
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "screenshotFile": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "v",
    "id",
    "sessionId",
    "sentAt",
    "kind",
    "requestId",
    "outcome",
    "enteredLines",
    "reason",
    "readback",
    "screenshotFile"
  ]
}
