{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "sessionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "sentAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "kind": {
      "type": "string",
      "const": "invoice.request"
    },
    "attempt": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "customer": {
      "type": "object",
      "properties": {
        "customerNo": {
          "type": "string",
          "minLength": 1
        },
        "carNo": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "customerNo",
        "carNo"
      ]
    },
    "approvedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "approval": {
      "type": "object",
      "properties": {
        "recordingId": {
          "type": "string"
        },
        "startSec": {
          "type": "number"
        },
        "endSec": {
          "type": "number"
        },
        "quote": {
          "type": "string"
        }
      },
      "required": [
        "recordingId",
        "startSec",
        "endSec",
        "quote"
      ]
    },
    "lines": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item": {
            "type": "string",
            "minLength": 1
          },
          "qty": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "unitPrice": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "amount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "unitPriceFrom": {
            "type": "string",
            "enum": [
              "ledger",
              "spoken",
              "answer"
            ]
          },
          "provenance": {
            "type": "object",
            "properties": {
              "recordingId": {
                "type": "string"
              },
              "startSec": {
                "type": "number"
              },
              "endSec": {
                "type": "number"
              },
              "quote": {
                "type": "string"
              }
            },
            "required": [
              "recordingId",
              "startSec",
              "endSec",
              "quote"
            ]
          }
        },
        "required": [
          "item",
          "qty",
          "unit",
          "unitPrice",
          "amount",
          "unitPriceFrom",
          "provenance"
        ]
      }
    },
    "total": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "totalSpoken": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "v",
    "id",
    "sessionId",
    "sentAt",
    "kind",
    "attempt",
    "customer",
    "approvedAt",
    "approval",
    "lines",
    "total",
    "totalSpoken"
  ]
}
